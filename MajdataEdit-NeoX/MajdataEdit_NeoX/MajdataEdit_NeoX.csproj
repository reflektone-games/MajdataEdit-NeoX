<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<RootNamespace>MajdataEdit_NeoX</RootNamespace>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<ItemGroup>
		<AvaloniaResource Include="Assets\**" />
	</ItemGroup>
	<ItemGroup>
		<AdditionalFiles Include="Assets\Localizations\en-US.json" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\MajdataEdit_NeoX.Generators\MajdataEdit_NeoX.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia" />
		<PackageReference Include="Avalonia.AvaloniaEdit" />
		<PackageReference Include="Avalonia.Skia" />
		<PackageReference Include="Avalonia.Themes.Fluent" />
		<PackageReference Include="Avalonia.Fonts.Inter" />
		<PackageReference Include="AvaloniaEdit.TextMate" />
		<PackageReference Include="AvaloniaUI.DiagnosticsSupport">
			<IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
			<PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
		</PackageReference>
		<PackageReference Include="bodong.Avalonia.PropertyGrid" />
		<PackageReference Include="Cimai" />
		<PackageReference Include="CommunityToolkit.Mvvm" />
		<PackageReference Include="Dock.Avalonia.Themes.Fluent" />
		<PackageReference Include="Dock.Model" />
		<PackageReference Include="Dock.Model.Mvvm" />
		<PackageReference Include="FFmpeg.AutoGen" />
		<PackageReference Include="FluentAvaloniaUI" />
		<PackageReference Include="Microsoft.Data.Sqlite" />
		<PackageReference Include="NuGet.Versioning" />
		<PackageReference Include="Reflektone.MajProtocol.Standard" />
		<PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
		<PackageReference Include="PropertyGenerator.Avalonia" />
		<PackageReference Include="SkiaSharp" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="simai.tmLanguage.json" />
		<EmbeddedResource Include="xxlb.png" />
		<EmbeddedResource Include="Plugins\*.lua" />
	</ItemGroup>

	<!--
		miniaudio native library: built per-host by the Desktop csproj into
		runtimes/<rid>/native/ (see Native/miniaudio.targets). The wrapper
		in Models/Track/MiniAudio.cs loads it via DllImport("miniaudio").

		RID conventions follow .NET:
		  win-x64   -> miniaudio.dll
		  osx       -> libminiaudio.dylib
		  linux-x64 -> libminiaudio.so
	-->
	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
		<None Include="runtimes\win-x64\native\miniaudio.dll" Condition="Exists('runtimes\win-x64\native\miniaudio.dll')">
			<Pack>true</Pack>
			<PackagePath>runtimes\win-x64\native</PackagePath>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Include="runtimes\osx\native\libminiaudio.dylib" Condition="Exists('runtimes\osx\native\libminiaudio.dylib')">
			<Pack>true</Pack>
			<PackagePath>runtimes\osx\native</PackagePath>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Include="runtimes\linux-x64\native\libminiaudio.so" Condition="Exists('runtimes\linux-x64\native\libminiaudio.so')">
			<Pack>true</Pack>
			<PackagePath>runtimes\linux-x64\native</PackagePath>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>
	<ItemGroup>
	  <Folder Include="Assets\Localizations\" />
	  <Folder Include="Docs\" />
	</ItemGroup>

</Project>