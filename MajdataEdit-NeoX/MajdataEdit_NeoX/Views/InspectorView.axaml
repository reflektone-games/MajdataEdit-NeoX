<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"

             xmlns:ll="clr-namespace:Avalonia.PropertyGrid.Localization;assembly=Avalonia.PropertyGrid"
             xmlns:conv="using:MajdataEdit_NeoX.Converters"
             xmlns:vm="using:MajdataEdit_NeoX.ViewModels"

             mc:Ignorable="d" d:DesignWidth="120" d:DesignHeight="430"
             x:Class="MajdataEdit_NeoX.Views.InspectorView"
             x:DataType="vm:MainViewModel"
             x:Name="Root">

    <UserControl.Resources>
        <conv:SecondsToTimeConverter x:Key="SecondsToTime" />
        <StreamGeometry x:Key="play_pause">M200-312v-336l240 168-240 168Zm320-8v-320h80v320h-80Zm160 0v-320h80v320h-80Z</StreamGeometry>
    </UserControl.Resources>

    <Grid ColumnDefinitions="2.2*,3*"
          RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">

        <Label Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="2"
               Height="90" FontSize="40" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="0 30 0 0"
               Content="{Binding #Root.DisplayTime, Converter={StaticResource SecondsToTime}}" />
        <DockPanel Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="2" Margin="0 -6 0 3">
            <Label Height="30" FontSize="10" DockPanel.Dock="Left"
                   HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="5 0 0 0"
                   Content="combo" Opacity="0.5" />
            <Label Height="30" FontSize="15" DockPanel.Dock="Right"
                   HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                   HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="0 0 0 0"
                   Content="{Binding #Root.DisplayCombo}" />
        </DockPanel>

        <ComboBox Grid.Column="0" Grid.Row="2" Grid.ColumnSpan="2" Margin="2 0 2 3"
                  VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                  SelectedIndex="{Binding #Root.SelectedDifficulty}">
            <ComboBoxItem Content="EASY" />
            <ComboBoxItem Content="BASIC" />
            <ComboBoxItem Content="ADVANCED" />
            <ComboBoxItem Content="EXPERT" />
            <ComboBoxItem Content="MASTER" />
            <ComboBoxItem Content="Re:MASTER" />
            <ComboBoxItem Content="ORIGINAL" />
        </ComboBox>

        <Label VerticalAlignment="Center" HorizontalAlignment="Center"
               Grid.Column="0" Grid.Row="3" Margin="5 0 5 3"
               FontSize="12" Content="{ll:Localize Gui_Level}" />
        <TextBox Grid.Column="1" Grid.Row="3" Margin="5 0 5 3"
                 Text="{Binding #Root.Level}" />

        <Label VerticalAlignment="Center" HorizontalAlignment="Center"
               Grid.Column="0" Grid.Row="4" Margin="5 0 5 3"
               FontSize="12" Content="{ll:Localize Gui_Designer}" />
        <TextBox Grid.Column="1" Grid.Row="4" Margin="5 0 5 3"
                 Text="{Binding #Root.Designer}" />

        <Label VerticalAlignment="Center" HorizontalAlignment="Center"
               Grid.Column="0" Grid.Row="5" Margin="5 0 5 3"
               FontSize="12" Content="{ll:Localize Gui_Offset}" />
        <NumericUpDown Grid.Column="1" Grid.Row="5" Margin="5 0 5 3"
                       Value="{Binding #Root.Offset}" ShowButtonSpinner="False" />

        <Label VerticalAlignment="Center" HorizontalAlignment="Center"
               Grid.Column="0" Grid.Row="6" Margin="4 0 5 3"
               FontSize="12" Content="{ll:Localize Gui_PlaybackSpeed}" />
        <NumericUpDown Grid.Column="1" Grid.Row="6" Margin="5 0 5 3"
                       Value="{Binding #Root.PlaybackSpeed}"
                       Minimum="0.1" Increment="0.1"
                       FormatString="0.##"
                       ShowButtonSpinner="False" />


        <CheckBox Grid.Column="0" Grid.Row="7" Grid.ColumnSpan="2"
                  IsChecked="{Binding #Root.IsFollowCursor}" Content="{ll:Localize Gui_FollowCursor}"
                  Margin="0 4 0 0" HorizontalAlignment="Center" />
        <StackPanel Grid.Column="0" Grid.Row="8"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
            <CheckBox IsChecked="{Binding #Root.IsConnected}" IsEnabled="False" Margin="15 4 0 0"
                      HorizontalAlignment="Center" />
            <TextBlock FontSize="8" Margin="5 -7 0 0" HorizontalAlignment="Center">
                <Run Text="Conn [" />
                <Run Text="{Binding #Root.ActiveConnectionCount}" />
                <Run Text="]" />
            </TextBlock>
        </StackPanel>
        <Button Grid.Column="1" Grid.Row="8" Margin="4 0 4 0" FontSize="12"
                VerticalAlignment="Center" HorizontalAlignment="Center"
                Content="{ll:Localize Gui_Record}" Command="{Binding PlayIncludeOp}" />

        <StackPanel Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="9"
                    Orientation="Horizontal" Spacing="5" Margin="0 6 0 0"
                    HorizontalAlignment="Center">
            <Button Height="50" Width="50" Command="{Binding PlayPause}">
                <PathIcon Data="{StaticResource play_pause}" />
            </Button>
        </StackPanel>

    </Grid>

</UserControl>
